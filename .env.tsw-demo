# Train-shaped demo telemetry for `npm run demo:tsw`.
#
# Used only by the Node development server: it produces frames in the same shape the Windows bridge
# publishes for the Train Sim World 6 source, so the train UI can be developed and reviewed on a
# machine that does not have the game installed. The real source is the game's own local HTTP API,
# which the exe reads on the machine running TSW6.
EFB_DEMO=1
EFB_DEMO_SOURCE=tsw
# Keep this clear of the exe's 8080 so both can run side by side while comparing.
EFB_PORT=8081
