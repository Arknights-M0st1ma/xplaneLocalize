# UDP address/port on this computer. 0.0.0.0 accepts packets on all interfaces.
XPLANE_UDP_HOST=0.0.0.0
XPLANE_UDP_PORT=49000
# Optional exact sender IP allow-list. Leave empty to accept any LAN sender.
XPLANE_SOURCE_IP=

# Web server address/port. 0.0.0.0 makes it reachable from the iPad.
EFB_HOST=0.0.0.0
EFB_PORT=8080
# Set to 1 (or run npm run demo) to preview without X-Plane.
EFB_DEMO=0

# Optional TLS. Both values must be supplied. HTTPS enables a service worker on iPad.
EFB_TLS_CERT=
EFB_TLS_KEY=

# Optional, approved XYZ tile service. Never place a secret token in this URL.
# Example placeholders: https://tiles.example.test/{z}/{x}/{y}.png
AUTHORIZED_CHART_TILE_URL=
AUTHORIZED_CHART_ATTRIBUTION=

# Optional authorized XYZ base map. URL may contain {z}, {x}, {y} placeholders.
CUSTOM_BASE_MAP_NAME=
CUSTOM_BASE_MAP_URL=
CUSTOM_BASE_MAP_ATTRIBUTION=

# Open external Navigraph Charts in a separate tab (no chart data is embedded).
NAVIGRAPH_EXTERNAL_URL=https://charts.navigraph.com/
