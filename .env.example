# UDP address/port on this computer. 0.0.0.0 accepts packets on all interfaces.
XPLANE_UDP_HOST=0.0.0.0
XPLANE_UDP_PORT=49000
# Optional exact sender IP allow-list. Leave empty to accept any LAN sender.
XPLANE_SOURCE_IP=

# Web server address/port. 0.0.0.0 makes it reachable from the iPad.
EFB_HOST=0.0.0.0
EFB_PORT=8080
# Set to 1 (or run npm run demo) to preview without X-Plane.
EFB_DEMO=0

# Optional TLS. Both values must be supplied. HTTPS enables a service worker on iPad.
EFB_TLS_CERT=
EFB_TLS_KEY=

# Optional authorized XYZ base map. URL may contain {z}, {x}, {y} placeholders.
CUSTOM_BASE_MAP_NAME=
CUSTOM_BASE_MAP_URL=
CUSTOM_BASE_MAP_ATTRIBUTION=

# Optional SimBrief route overlay. Fill in your SimBrief Pilot ID (1-7 digits)
# or your Navigraph alias. The bridge only calls SimBrief when the iPad asks
# for a refresh, never in the background.
SIMBRIEF_USER=
# Override the API endpoint only if you know why; default is the official one.
SIMBRIEF_API_URL=
# Note: the proxy settings (system / none / manual) exist in the Windows exe only.
# This Node development server always connects directly.

# Optional OpenWeatherMap API key for the weather overlays (dev server only;
# the exe keeps it in its own config file). The key stays on this machine: the
# browser only asks the bridge for tiles.
OWM_API_KEY=
# Override the tile upstream (diagnostics/tests only).
EFB_OWM_BASE=
